apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: immich
  namespace: argocd
spec:
  project: default
  source:
    repoURL: https://github.com/gokul1630/homelab
    path: helm/immich
    targetRevision: HEAD
    helm:
      parameters:
        - name: database.username
          value: "{{ argocd_immich_database_username }}"
        - name: database.password
          value: "{{ argocd_immich_database_password }}"
  destination:
    server: https://kubernetes.default.svc
    namespace: immich
  syncPolicy:
    automated:
      enabled: true
      prune: false
      selfHeal: false
    syncOptions:
      - CreateNamespace=true